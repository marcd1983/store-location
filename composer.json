        "silverstripe/cms": "^6.0",
        "dnadesign/silverstripe-elemental": "^6.0",
        "silverstripe/userforms": "^7.0",
        "symbiote/silverstripe-gridfieldextensions": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Antlion\\StoreLocation\\": "src/"
        }
    },
    "config": {
        "process-timeout": 600
    }
}